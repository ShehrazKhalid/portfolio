{
  "name": "shehraz-portfolio-grove",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive driving portfolio with complete local project galleries and destructible scenery",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node tools/build.mjs --dist",
    "media": "node tools/download-media.mjs",
    "prepare-site": "node tools/download-media.mjs && node tools/build.mjs --dist",
    "test": "node --test tests/*.test.mjs",
    "qa:browser": "node tests/browser-qa.mjs",
    "verify": "node tools/verify-site.mjs"
  }
}
